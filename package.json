{
  "name": "cce-talent-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "seed:build": "tsx scripts/build-seed.ts",
    "seed:apply": "tsx --env-file=.env.local scripts/run-sql.ts supabase/seed.sql",
    "sample:load": "tsx --env-file=.env.local scripts/run-sql.ts supabase/sample-data.sql",
    "sample:remove": "tsx --env-file=.env.local scripts/run-sql.ts supabase/remove-sample-data.sql",
    "db:push": "supabase db push",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
