# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Netlify, add the same names under Site configuration > Environment variables.

# --- Site ---
# The public address of the talent site. Change here if the domain changes.
NEXT_PUBLIC_SITE_URL=https://talent.partnerwithcce.com

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable / anon key. Safe in the browser: access rules (RLS) protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. SERVER ONLY. Bypasses access rules. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Project Settings > Database). Used by seed scripts only.
DATABASE_URL=

# --- Claude API (resume extraction). SERVER ONLY. ---
ANTHROPIC_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="CCE Talent Network <talent@partnerwithcce.com>"
EMAIL_REPLY_TO=talent@partnerwithcce.com

# --- Slack incoming webhooks ---
# New-application pings
SLACK_WEBHOOK_APPLICATIONS=
# Failure alerts (#tech)
SLACK_WEBHOOK_ALERTS=

# --- Scheduled jobs (keep-alive, cleanup) ---
# Any long random string. The daily job must send it to run.
CRON_SECRET=

# --- Tests only ---
# A Postgres superuser connection for the database tests (see README, Testing).
TEST_DATABASE_URL=
